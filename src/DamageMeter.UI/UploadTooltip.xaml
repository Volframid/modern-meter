<UserControl x:Class="DamageMeter.UI.UploadTooltip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" >
    <Border Background="{DynamicResource ModernCard}" BorderBrush="{DynamicResource ModernLine}" BorderThickness="1" CornerRadius="8" Padding="4" TextElement.FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="UpdateStatusTb" Text="{DynamicResource ModernText_5C18BBBBC16C}" Foreground="{DynamicResource ModernText}" FontSize="16" Margin="10" />
        <StackPanel Grid.Row="1" Margin="5">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource ModernText_AEF7DE28D529}" Foreground="{DynamicResource ModernMuted}" />
                <TextBlock x:Name="ServerTb" Foreground="{DynamicResource ModernText}" Grid.Column="1">Server home</TextBlock>
            </Grid>
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource ModernText_33B93476CF59}" Foreground="{DynamicResource ModernMuted}" />
                <TextBlock x:Name="TimeTb" Foreground="{DynamicResource ModernText}" Grid.Column="1">00:00 01/01/1970</TextBlock>
            </Grid>
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource ModernText_2F77668A9DFB}" Foreground="{DynamicResource ModernMuted}" />
                <TextBlock x:Name="MessageTb" Foreground="{DynamicResource ModernText}" Grid.Column="1">Response message</TextBlock>
            </Grid>
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource ModernText_39FCABC22C85}" Foreground="{DynamicResource ModernMuted}" />
                <TextBlock x:Name="NpcNameTb" Foreground="{DynamicResource ModernText}" Grid.Column="1">Npc name</TextBlock>
            </Grid>
            <Grid Margin="5" x:Name="ExceptionGrid" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource ModernText_54A0E8C17EBB}" Foreground="{DynamicResource ModernMuted}" />
                <TextBlock x:Name="ExceptionTb" Foreground="{DynamicResource ModernText}" Grid.Column="1">Exception message</TextBlock>
            </Grid>
        </StackPanel>
    </Grid>
    </Border>
</UserControl>
