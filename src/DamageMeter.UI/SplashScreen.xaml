<Window x:Class="DamageMeter.UI.SplashScreen"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:DamageMeter.UI"
 Title="Modern Meter" Width="560" SizeToContent="Height" MinHeight="296" MaxHeight="560"
 ResizeMode="NoResize" AllowsTransparency="True" WindowStyle="None" Background="Transparent"
 ShowInTaskbar="False" WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
 FontFamily="Segoe UI" Foreground="#F0F2FA" MouseLeftButtonDown="Window_MouseLeftButtonDown"
 xmlns:mm="clr-namespace:DamageMeter.UI" Icon="{x:Static mm:ModernDamageMark.ApplicationImage}">
 <Window.Resources>
  <Style x:Key="SplashButton" TargetType="Button">
   <Setter Property="Foreground" Value="#F0F2FA"/><Setter Property="Background" Value="#1B202B"/>
   <Setter Property="BorderBrush" Value="#343B4C"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="18,9"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#AD8AFF"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#AD8AFF"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.7"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Border x:Name="SplashFrame" Margin="12" CornerRadius="16" BorderThickness="1" BorderBrush="#343B4C" Background="#14171F" Padding="30,27,30,24">
  <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.28" Color="#000000"/></Border.Effect>
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="MODERN METER" FontSize="10" FontWeight="SemiBold" Foreground="#AD8AFF"/>
    <TextBlock x:Name="ver" Grid.Column="1" FontSize="10" Foreground="#A7AFC4" VerticalAlignment="Center"/>
   </Grid>
   <Grid Grid.Row="1" Margin="0,28,0,25">
    <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Width="56" Height="56" CornerRadius="13" Background="#272238" BorderBrush="#514269" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center">
     <Image Source="{x:Static ui:ModernDamageMark.Glyph}" Width="50" Height="50"/>

    </Border>
    <StackPanel Grid.Column="1" VerticalAlignment="Center">
     <TextBlock Text="Modern Meter" FontSize="32" FontWeight="SemiBold" Margin="0,-3,0,4"/>
     <TextBlock Text="{DynamicResource ModernText_90E640097904}" FontSize="12" Foreground="#A7AFC4" TextWrapping="Wrap"/>
    </StackPanel>
   </Grid>
   <Border Grid.Row="2" Background="#1B202B" CornerRadius="9" BorderBrush="#2C3342" BorderThickness="1" Padding="14,13">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="4"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Ellipse Width="5" Height="5" Fill="#AD8AFF" VerticalAlignment="Top" Margin="0,6,0,0" HorizontalAlignment="Left"/>
      <TextBlock x:Name="txt" Grid.Column="1" Text="{DynamicResource ModernText_652A61C2A7A1}" FontSize="12" Foreground="#D5D9E5" TextWrapping="Wrap" MaxHeight="130"/>
     </Grid>
     <Border Grid.Row="1" CornerRadius="2" Background="#303545" ClipToBounds="True">
      <Rectangle Width="120" HorizontalAlignment="Left" RadiusX="2" RadiusY="2">
       <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#006F91D8" Offset="0"/><GradientStop Color="#AD8AFF" Offset="0.55"/><GradientStop Color="#00AD8AFF" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
       <Rectangle.RenderTransform><TranslateTransform X="-120"/></Rectangle.RenderTransform>
       <Rectangle.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-120" To="460" Duration="0:0:1.7"/></Storyboard></BeginStoryboard></EventTrigger></Rectangle.Triggers>
      </Rectangle>
     </Border>
    </Grid>
   </Border>
   <UniformGrid Grid.Row="3" x:Name="buttonsGrid" Rows="1" Columns="2" Margin="0,18,0,0">
    <UniformGrid.LayoutTransform><ScaleTransform ScaleY="0"/></UniformGrid.LayoutTransform>
    <Button x:Name="DeclineUpdate" Content="{DynamicResource ModernText_73B6E48A1B55}" Style="{StaticResource SplashButton}" Margin="0,0,6,0" Click="NoClick"/>
    <Button x:Name="AcceptUpdate" Content="{DynamicResource ModernText_63BF045213CE}" Style="{StaticResource SplashButton}" Margin="6,0,0,0" Background="#352B4B" BorderBrush="#756098" Click="OkClick"/>
   </UniformGrid>
  </Grid>
 </Border>
</Window>