    <sys:String x:Key="ModernText_F67B87241682">Le notifiche di chat e gruppo appaiono solo con TERA in secondo piano.</sys:String>
    <sys:String x:Key="ModernText_4F885A7C87DB">Aggiornamenti al secondo. 20 Hz = ogni 50 ms. Valori maggiori usano più CPU.</sys:String>
