    <sys:String x:Key="ModernText_5493FF8E9397">ÁREA DE TRABAJO</sys:String>
    <sys:String x:Key="ModernText_F67B87241682">Las notificaciones de chat y grupo aparecen solo con TERA en segundo plano.</sys:String>
    <sys:String x:Key="ModernText_4F885A7C87DB">Actualizaciones por segundo. 20 Hz = cada 50 ms. Valores mayores consumen más CPU.</sys:String>
