<ui:ClickThrouWindow x:Class="DamageMeter.UI.TeradpsHistory"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:ui="clr-namespace:DamageMeter.UI"
                     mc:Ignorable="d"
                     MinHeight="38" MinWidth="230"
                     Title="Modern Meter — Upload history">
    <Window.Background>
        <SolidColorBrush Color="Transparent" Opacity="0" />
    </Window.Background>
    <Window.Resources>
        <Style x:Key="ModernAuxButton" TargetType="Button" BasedOn="{StaticResource ModernButton}"><Setter Property="Padding" Value="4"/><Setter Property="Margin" Value="0"/></Style>
    </Window.Resources>
    <Grid MouseLeftButtonDown="Move" Margin="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ui:ClickThrouWindow}, Path=AllowsTransparency, Converter={StaticResource BoolToMargin}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.LayoutTransform>
            <ScaleTransform CenterX="0" CenterY="0"
                            ScaleX="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ui:ClickThrouWindow}, Path=Scale}"
                            ScaleY="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ui:ClickThrouWindow}, Path=Scale}" />
        </Grid.LayoutTransform>
        <Border Style="{StaticResource MainBorder}" Grid.RowSpan="2" CornerRadius="10" Background="{DynamicResource ModernSurface}" BorderBrush="{DynamicResource ModernLine}" BorderThickness="1"/>
        <TextBlock Grid.Row="0" Margin="14,0,44,0" Text="{DynamicResource ModernText_7C85D9A08565}" FontFamily="Segoe UI" FontSize="12" Foreground="{DynamicResource ModernText}" VerticalAlignment="Center" IsHitTestVisible="False"/>
        <Button Grid.Row="0" x:Name="CloseStats" HorizontalAlignment="Right" Width="34" Style="{StaticResource ModernAuxButton}" Background="Transparent"
                Opacity="0.85"
                Foreground="White" Click="Close_OnClick" HorizontalContentAlignment="Stretch"
                VerticalAlignment="Top" Margin="0">
            <Image x:Name="CloseWindow"
                   Stretch="Fill"
                   HorizontalAlignment="Left"
                   Height="29" VerticalAlignment="Top" Width="29" />
        </Button>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <ItemsControl Name="TeraDpsHistory" Background="Transparent" BorderThickness="0"
                              Focusable="False"
                              HorizontalContentAlignment="Stretch" IsTextSearchEnabled="False"
                              HorizontalAlignment="Left" />
            </Grid>
        </ScrollViewer>
    </Grid>
</ui:ClickThrouWindow>