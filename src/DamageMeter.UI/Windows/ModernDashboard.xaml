<Window x:Class="DamageMeter.UI.Windows.ModernDashboard"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="clr-namespace:DamageMeter.UI" xmlns:charts="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 xmlns:settings="clr-namespace:TCC.UI.Controls.Settings" xmlns:controls="clr-namespace:DamageMeter.UI.Controls"
 WindowStyle="None" Title="{DynamicResource ModernText_86D5A0DDD77C}" Width="1060" Height="740" MinWidth="820" MinHeight="580" WindowStartupLocation="CenterScreen"
 Background="{DynamicResource ModernSurface}" Foreground="{DynamicResource ModernText}" FontFamily="Segoe UI" FontSize="13"
 xmlns:mm="clr-namespace:DamageMeter.UI" Icon="{x:Static mm:ModernDamageMark.ApplicationImage}">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="12"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <DataTemplate x:Key="EncounterLabel"><StackPanel Margin="8,4"><TextBlock Text="{Binding Info.Name}" Foreground="{DynamicResource ModernAccent}"/><TextBlock Text="{Binding Info.Area}" Style="{StaticResource ModernCaption}"/></StackPanel></DataTemplate>
 </Window.Resources>
 <Border x:Name="DashboardFrame" CornerRadius="12" BorderBrush="{DynamicResource ModernLine}" BorderThickness="1" Background="{DynamicResource ModernSurface}">
 <Grid><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Margin="14,0,5,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Image x:Name="ChromeBrandIcon" Style="{StaticResource ModernCaptionIcon}"/>
   <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
    <Button Content="−" Click="MinimizeWindow" Style="{StaticResource ModernChromeButton}" ToolTip="{DynamicResource ModernText_D72E311C4DDA}"/>
    <Button Content="□" Click="MaximizeWindow" Style="{StaticResource ModernChromeButton}" ToolTip="{DynamicResource ModernText_AB9616C1C81C}"/>
    <Button Content="×" Click="CloseDashboard" Style="{StaticResource ModernChromeButton}" ToolTip="{DynamicResource ModernText_7D9EB7ACB13E}"/>
   </StackPanel>
  </Grid>
 <Grid Grid.Row="1" Background="{DynamicResource ModernSurface}" Margin="12,8,16,14">
  <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel Margin="20,0,8,12">
   <TextBlock Text="{DynamicResource ModernText_4D1D4EE3F619}" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource ModernAccent}" VerticalAlignment="Center"/>
   <TextBlock Text="{DynamicResource ModernText_15CD1D55721A}" Style="{StaticResource ModernCaption}" Margin="22,0,0,0" VerticalAlignment="Center"/>
   <Button  Style="{StaticResource ModernButton}" Command="{Binding OpenSettingsCommand}" HorizontalAlignment="Right"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource Svg.Settings}" Fill="{DynamicResource ModernMuted}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0"/><TextBlock Text="{DynamicResource ModernText_202557CEABC1}"/></StackPanel></Button>
  </DockPanel>
  <TabControl HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" x:Name="Navigation" Style="{StaticResource ModernSidebar}" Grid.Row="1" TabStripPlacement="Left" Background="Transparent" BorderThickness="0" Padding="18,0,0,0">
   <TabControl.Resources><Style TargetType="TabItem" BasedOn="{StaticResource ModernNavigation}"/></TabControl.Resources>
   <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><Path Data="{StaticResource Svg.Graph}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/><TextBlock Text="{DynamicResource ModernText_D4B1EA5708DD}" VerticalAlignment="Center"/></StackPanel></TabItem.Header>
    <Grid Margin="4,0,0,0">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="170"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,18">
      <StackPanel><TextBlock Text="{DynamicResource ModernText_4D8CDC4DE8B3}" Style="{StaticResource ModernHeading}"/><TextBlock Text="{DynamicResource ModernText_EE48BBB0C412}" Style="{StaticResource ModernCaption}" Margin="0,5,0,0"/></StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button  Click="ExportJson" Style="{StaticResource ModernButton}" Margin="8,0"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource Svg.Export}" Fill="{DynamicResource ModernMuted}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0"/><TextBlock Text="{DynamicResource ModernText_FF25653EE9E4}"/></StackPanel></Button><Button  Click="ResetEncounter" Style="{StaticResource ModernButton}"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource Svg.Reset}" Fill="{DynamicResource ModernMuted}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0"/><TextBlock Text="{DynamicResource ModernText_DAEE7606B339}"/></StackPanel></Button></StackPanel>
     </DockPanel>
     <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,14">
      <Border Style="{StaticResource ModernCardStyle}" Margin="0,0,8,0"><StackPanel><TextBlock Text="{DynamicResource ModernText_E5FF36B9CFC0}" Style="{StaticResource ModernCaption}"/><TextBlock Text="{Binding TotalDpsText}" Style="{StaticResource ModernHeading}" Margin="0,5,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource ModernCardStyle}" Margin="4,0,4,0"><StackPanel><TextBlock Text="{DynamicResource ModernText_D57274B3C2A2}" Style="{StaticResource ModernCaption}"/><TextBlock Text="{Binding TotalDamageText}" Style="{StaticResource ModernHeading}" Margin="0,5,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource ModernCardStyle}" Margin="8,0,0,0"><StackPanel><TextBlock Text="{DynamicResource ModernText_EBD293E02C29}" Style="{StaticResource ModernCaption}"/><TextBlock Text="{Binding TimerText}" Style="{StaticResource ModernHeading}" Margin="0,5,0,0"/></StackPanel></Border>
     </UniformGrid>
     <Border Grid.Row="2" Style="{StaticResource ModernCardStyle}" Padding="0">
      <DockPanel>
       <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource ModernLine}" BorderThickness="0,0,0,1" Padding="12,8">
        <ComboBox ItemsSource="{Binding Encounters}" SelectedItem="{Binding SelectedEncounter}" SelectionChanged="SelectEncounter" ItemTemplate="{StaticResource EncounterLabel}" MinHeight="34" Style="{StaticResource ModernCombo}"/>
       </Border>
       <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding PlayersView}"><ItemsControl.ItemTemplate><DataTemplate><ui:PlayerStatsControl/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
      </DockPanel>
     </Border>
     <Border Grid.Row="3" Style="{StaticResource ModernCardStyle}" Margin="0,14,0,0" Padding="12">
      <DockPanel><TextBlock DockPanel.Dock="Top" Text="{DynamicResource ModernText_9A023D9F2424}" Style="{StaticResource ModernCaption}" Margin="0,0,0,8"/>
       <Grid><charts:CartesianChart Series="{Binding GraphData.DpsSeries}" XAxes="{Binding GraphData.XAxes}" YAxes="{Binding GraphData.YAxes}" Sections="{Binding GraphData.EnrageSections}" AnimationsSpeed="0"/>
        <TextBlock Text="{DynamicResource ModernText_A268006B341E}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center">
         <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource ModernCaption}"><Style.Triggers><DataTrigger Binding="{Binding GraphData.IsChartVisible}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
       </Grid>
      </DockPanel>
     </Border>
    </Grid>
   </TabItem>
   <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><Path Data="{StaticResource Svg.History}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/><TextBlock Text="{DynamicResource ModernText_536325061125}" VerticalAlignment="Center"/></StackPanel></TabItem.Header>
    <Grid Margin="4,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,20"><TextBlock Text="{DynamicResource ModernText_536325061125}" Style="{StaticResource ModernHeading}"/><TextBlock Text="{DynamicResource ModernText_EF3F229D0621}" Style="{StaticResource ModernCaption}" Margin="0,6,0,0"/></StackPanel>
     <ListBox Grid.Row="1" Background="{DynamicResource ModernCard}" Foreground="{DynamicResource ModernText}" BorderBrush="{DynamicResource ModernLine}" ItemContainerStyle="{StaticResource ModernListItem}" ItemsSource="{Binding Encounters}" SelectedItem="{Binding SelectedEncounter}" SelectionChanged="SelectEncounter" ItemTemplate="{StaticResource EncounterLabel}"/>
    </Grid>
   </TabItem>
   <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><Path Data="{StaticResource Svg.EntityStats}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/><TextBlock Text="{DynamicResource ModernText_84E12AC655DD}" VerticalAlignment="Center"/></StackPanel></TabItem.Header>
    <Grid Margin="4,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,20"><TextBlock Text="{DynamicResource ModernText_DFE9FA871C80}" Style="{StaticResource ModernHeading}"/><TextBlock Text="{DynamicResource ModernText_7FE53AFEDF77}" Style="{StaticResource ModernCaption}" Margin="0,6,0,0"/></StackPanel>
     <DataGrid Grid.Row="1" ItemsSource="{Binding PlayersView}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource ModernLine}" RowBackground="{DynamicResource ModernCard}" AlternatingRowBackground="{DynamicResource ModernSurface}" Background="{DynamicResource ModernSurface}" Foreground="{DynamicResource ModernText}" BorderThickness="0" RowHeight="44" SelectionMode="Single">
      <DataGrid.Resources><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource ModernCard}"/><Setter Property="Foreground" Value="{DynamicResource ModernMuted}"/><Setter Property="Padding" Value="10"/></Style><Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,6"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#28AD8AFF"/><Setter Property="Foreground" Value="{DynamicResource ModernText}"/></Trigger></Style.Triggers></Style></DataGrid.Resources>
      <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ContextMenu"><Setter.Value><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><MenuItem Header="{DynamicResource ModernText_1343D0AD2D9F}" Command="{Binding ShowSkillDetailsCommand}"/></ContextMenu></Setter.Value></Setter></Style></DataGrid.RowStyle>
      <DataGrid.Columns><DataGridTextColumn Header="{DynamicResource ModernText_64AEE8C6CBD0}" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="{DynamicResource ModernText_CAECE7F58FCE}" Binding="{Binding GlobalDps}" Width="100"/><DataGridTextColumn Header="{DynamicResource ModernText_0C874F581A45}" Binding="{Binding DamageDone}" Width="110"/><DataGridTextColumn Header="{DynamicResource ModernText_29887A5FF984}" Binding="{Binding DamagePerc}" Width="80"/><DataGridTextColumn Header="{DynamicResource ModernText_FA660418DDAD}" Binding="{Binding CritRate}" Width="80"/><DataGridTextColumn Header="{DynamicResource ModernText_CAB73116D7F9}" Binding="{Binding Deaths}" Width="70"/></DataGrid.Columns>
     </DataGrid>
    </Grid>
   </TabItem>
   <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><Path Data="{StaticResource Svg.Settings}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/><TextBlock Text="{DynamicResource ModernText_3907FA7F8072}" VerticalAlignment="Center"/></StackPanel></TabItem.Header>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="4,0,0,0">
     <TextBlock Text="{DynamicResource ModernText_780354B5D4D7}" Style="{StaticResource ModernHeading}"/>
     <TextBlock Text="{DynamicResource ModernText_0C662309FAC4}" Style="{StaticResource ModernCaption}" Margin="0,8,0,22"/>
     <Border Style="{StaticResource ModernCardStyle}"><StackPanel x:Name="AppearancePanel">
      <DockPanel Margin="0,0,0,16"><TextBlock Text="{DynamicResource ModernText_DCDE76EC8DCF}" Foreground="{DynamicResource ModernAccent}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource ModernText_6ADF2B9869B0}" Style="{StaticResource ModernCaption}" HorizontalAlignment="Right"/></DockPanel>
      <Grid Height="58"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="220"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource ModernText_C02268EBE2FC}"/><TextBlock Text="{DynamicResource ModernText_5318D4C86F5C}" Style="{StaticResource ModernCaption}" Margin="0,4,0,0"/></StackPanel><Slider Style="{StaticResource ModernSlider}" x:Name="OverlayOpacitySlider" Grid.Column="1" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1" Value="{Binding MainWindowOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/><controls:ModernNumberBox x:Name="OverlayOpacityNumber" Grid.Column="2" Value="{Binding MainWindowOpacityPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Step="1" Margin="12,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource ModernText_C02268EBE2FC}"/></Grid>
      <Grid Height="58"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="220"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource ModernText_82B31723E898}"/><TextBlock Text="{DynamicResource ModernText_4E21A699EEDA}" Style="{StaticResource ModernCaption}" Margin="0,4,0,0"/></StackPanel><Slider Style="{StaticResource ModernSlider}" x:Name="UiScaleSlider" Grid.Column="1" Minimum="0" Maximum="100" SmallChange="0.1" LargeChange="10" Value="{Binding ScaleLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/><controls:ModernNumberBox x:Name="UiScaleNumber" Grid.Column="2" Value="{Binding ScaleLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Step="0.1" Margin="12,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource ModernText_82B31723E898}"/></Grid>
      <Separator Margin="0,12" Background="{DynamicResource ModernLine}"/>
      <settings:CheckboxSetting Height="44" SettingName="{DynamicResource ModernText_56130E653E13}" IsOn="{Binding StayTopmost, Mode=TwoWay}"/>
      <settings:CheckboxSetting Height="44" SettingName="{DynamicResource ModernText_F262DBF4736F}" IsOn="{Binding ClickThru, Mode=TwoWay}"/>
      <settings:CheckboxSetting Height="44" SettingName="{DynamicResource ModernText_82EE0A5165F3}" IsOn="{Binding RealtimeGraphEnabled, Mode=TwoWay}"/>
      <Grid Height="52"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="220"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource ModernText_1C04EBFF4651}" ToolTip="{DynamicResource ModernText_6ECD7B78E3BD}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{DynamicResource ModernText_25F32CC6B1A5}" Style="{StaticResource ModernCaption}" HorizontalAlignment="Right" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="~1 Hz" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
     </StackPanel></Border>
     <TextBlock Text="{DynamicResource ModernText_93540DF040F9}" Style="{StaticResource ModernCaption}" Margin="0,16,0,0"/>
    </StackPanel></ScrollViewer>
   </TabItem>
  </TabControl>
 </Grid>
 </Grid></Border>
</Window>
