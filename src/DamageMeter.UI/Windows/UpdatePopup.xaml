<ui:ClickThrouWindow x:Class="DamageMeter.UI.Windows.UpdatePopup"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="clr-namespace:DamageMeter.UI"
 xmlns:markdig="clr-namespace:Markdig.Wpf;assembly=Markdig.Wpf"
 Title="{DynamicResource ModernText_79CACD2CD796}" Height="480" Width="780" MinHeight="280" MinWidth="440"
 FontFamily="Segoe UI" Foreground="{DynamicResource ModernText}" Background="Transparent"
 WindowStartupLocation="CenterScreen" ResizeMode="CanResize" Loaded="ClickThrouWindow_Loaded"
 xmlns:mm="clr-namespace:DamageMeter.UI" Icon="{x:Static mm:ModernDamageMark.ApplicationImage}">
 <Window.Resources>
  <Style x:Key="{x:Static markdig:Styles.Heading1StyleKey}" TargetType="{x:Type Paragraph}"><Setter Property="Foreground" Value="{DynamicResource ModernText}"/><Setter Property="FontSize" Value="28"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,10,0,12"/></Style>
  <Style x:Key="{x:Static markdig:Styles.Heading2StyleKey}" TargetType="{x:Type Paragraph}"><Setter Property="Foreground" Value="{DynamicResource ModernText}"/><Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,10,0,12"/></Style>
  <Style x:Key="{x:Static markdig:Styles.Heading3StyleKey}" TargetType="{x:Type Paragraph}"><Setter Property="Foreground" Value="{DynamicResource ModernText}"/><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,10,0,12"/></Style>
  <Style x:Key="{x:Static markdig:Styles.Heading4StyleKey}" TargetType="{x:Type Paragraph}"><Setter Property="Foreground" Value="{DynamicResource ModernText}"/><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,10,0,12"/></Style>
  <Style x:Key="{x:Static markdig:Styles.Heading5StyleKey}" TargetType="{x:Type Paragraph}"><Setter Property="Foreground" Value="{DynamicResource ModernText}"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,10,0,12"/></Style>
  <Style x:Key="{x:Static markdig:Styles.Heading6StyleKey}" TargetType="{x:Type Paragraph}"><Setter Property="Foreground" Value="{DynamicResource ModernText}"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,10,0,12"/></Style>
  <Style x:Key="{x:Static markdig:Styles.DocumentStyleKey}" TargetType="FlowDocument"><Setter Property="Foreground" Value="{DynamicResource ModernText}"/><Setter Property="Background" Value="{DynamicResource ModernCard}"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="13"/><Setter Property="PagePadding" Value="0"/></Style>
  <Style x:Key="{x:Static markdig:Styles.CodeBlockStyleKey}" TargetType="Paragraph"><Setter Property="Background" Value="#262D3A"/><Setter Property="Foreground" Value="{DynamicResource ModernText}"/><Setter Property="FontFamily" Value="Consolas"/><Setter Property="Padding" Value="10"/></Style>
  <Style x:Key="{x:Static markdig:Styles.CodeStyleKey}" TargetType="Run"><Setter Property="Background" Value="#262D3A"/><Setter Property="Foreground" Value="#D6C5FF"/><Setter Property="FontFamily" Value="Consolas"/></Style>
  <Style x:Key="{x:Static markdig:Styles.ThematicBreakStyleKey}" TargetType="Line"><Setter Property="Stroke" Value="{DynamicResource ModernLine}"/><Setter Property="Stretch" Value="Fill"/></Style>
  <Style TargetType="FlowDocument"><Setter Property="Background" Value="{DynamicResource ModernCard}"/><Setter Property="Foreground" Value="{DynamicResource ModernText}"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="13"/></Style>
 </Window.Resources>
 <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="12"/></WindowChrome.WindowChrome>
 <Border CornerRadius="12" BorderBrush="{DynamicResource ModernLine}" BorderThickness="1" Background="{DynamicResource ModernSurface}" Padding="18,12,18,16">
  <Grid MouseLeftButtonDown="Move">
   <Grid.LayoutTransform><ScaleTransform ScaleX="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ui:ClickThrouWindow}, Path=Scale}" ScaleY="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ui:ClickThrouWindow}, Path=Scale}"/></Grid.LayoutTransform>
   <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Image x:Name="ChromeBrandIcon" Style="{StaticResource ModernCaptionIcon}" Margin="0,0,12,0"/>
     <TextBlock Text="MODERN METER" Foreground="{DynamicResource ModernAccent}" FontSize="11" FontWeight="SemiBold" Margin="0,0,16,0"/>
     <TextBlock Text="{DynamicResource NativeText_App_Update_Available}" FontSize="13" Foreground="{DynamicResource ModernText}"/>
    </StackPanel>
    <Button Grid.Column="1" x:Name="CloseButton" Style="{StaticResource ModernButton}" Padding="7" Background="Transparent" BorderThickness="0" Click="CloseButton_OnClick" ToolTip="{DynamicResource NativeText_Close}">
     <Image x:Name="CloseWindow" Opacity="0.75" Width="16" Height="16"/>
    </Button>
   </Grid>
   <Border Grid.Row="1" CornerRadius="9" Background="{DynamicResource ModernCard}" BorderBrush="{DynamicResource ModernLine}" BorderThickness="1" Padding="14" Margin="0,10,0,0">
    <Grid><Grid.CommandBindings><CommandBinding Command="{x:Static markdig:Commands.Hyperlink}" Executed="OpenHyperlink"/></Grid.CommandBindings>
     <markdig:MarkdownViewer x:Name="Browser" Background="{DynamicResource ModernCard}" Foreground="{DynamicResource ModernText}" FontFamily="Segoe UI" FontSize="13"/>
    </Grid>
   </Border>
   <TextBlock Grid.Row="2" Text="{DynamicResource NativeText_App_Do_you_want_to_update}" Foreground="{DynamicResource ModernMuted}" TextWrapping="Wrap" Margin="0,16,0,14"/>
   <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
    <Button x:Name="CloseButton1" Style="{StaticResource ModernButton}" Content="{DynamicResource NativeText_Close}" Click="CloseButton_OnClick" MinWidth="94" Margin="0,0,10,0"/>
    <Button x:Name="UpdateButton" Style="{StaticResource ModernButton}" Content="{DynamicResource ModernText_63BF045213CE}" Click="StartButton_OnClick" MinWidth="114" Background="#352B4B" BorderBrush="#756098" FontWeight="SemiBold"/>
   </StackPanel>
  </Grid>
 </Border>
</ui:ClickThrouWindow>
