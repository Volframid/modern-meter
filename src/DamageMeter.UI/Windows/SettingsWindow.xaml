<Window x:Class="DamageMeter.UI.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DamageMeter.UI.Windows"
        xmlns:lang="clr-namespace:Lang;assembly=Lang"
        xmlns:settings="clr-namespace:TCC.UI.Controls.Settings"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:teraDpsApi="clr-namespace:DamageMeter.TeraDpsApi;assembly=DamageMeter"
        xmlns:ui="clr-namespace:DamageMeter.UI"
        xmlns:settingsViews="clr-namespace:DamageMeter.UI.Windows.SettingsViews"
        xmlns:data="clr-namespace:Data;assembly=Data"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:converters="clr-namespace:DamageMeter.UI.HUD.Converters"
        Background="{StaticResource DarkBackgroundColor}"
        WindowStyle="None"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        Closing="OnClosing" KeyDown="OnKeyDown"
        KeyUp="OnKeyUp"
        mc:Ignorable="d"
        FontFamily="Segoe UI" Title="{DynamicResource ModernText_073CE67DF610}" Height="720" Width="960" MinWidth="800" MinHeight="600"
        d:DataContext="{d:DesignInstance local:SettingsWindowViewModel}">
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="12"/></shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource ButtonMainStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="40" />
        </Style>
        <Style TargetType="settings:CheckboxSetting" BasedOn="{StaticResource {x:Type settings:CheckboxSetting}}">
            <Setter Property="CheckboxSize" Value="14" />
            <Setter Property="Margin" Value="32 0 0 0" />
            <Setter Property="CheckBoxColor">
                <Setter.Value>
                    <SolidColorBrush x:Name="cb" Color="{Binding SelfColor}" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="settings:ValueSetting">
            <Setter Property="Height" Value="32" />
            <Setter Property="SliderColor1">
                <Setter.Value>
                    <SolidColorBrush x:Name="c1" Color="{Binding SelfColor}" Opacity=".8" />
                </Setter.Value>
            </Setter>
            <Setter Property="SliderColor2">
                <Setter.Value>
                    <SolidColorBrush x:Name="c2" Color="{Binding SelfColor}" />
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="MetricComboBox" TargetType="ComboBox" BasedOn="{StaticResource ModernCombo}">
            <Setter Property="ItemsSource" Value="{Binding AvailableMetrics}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="10,5"/><Setter Property="MinWidth" Value="230"/></Style></Setter.Value></Setter>
            <Setter Property="MinWidth" Value="90"/><Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="ItemTemplate"><Setter.Value><DataTemplate>
                <TextBlock Text="{ui:LocalizedValue Converter={StaticResource EnumDescriptionConverter}}" TextTrimming="CharacterEllipsis" ToolTip="{ui:LocalizedValue Converter={StaticResource EnumDescriptionConverter}}"/>
            </DataTemplate></Setter.Value></Setter>
        </Style>
        <DataTemplate x:Key="MockPlayer" DataType="local:MockPlayerViewModel">
            <Border Background="{DynamicResource ModernCard}" BorderBrush="{DynamicResource ModernLine}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <Border Width="280" HorizontalAlignment="Left" CornerRadius="6" BorderThickness="1" Margin="0,0,0,12">
                        <Border.Background><SolidColorBrush Color="{Binding DataContext.BackgroundColor, RelativeSource={RelativeSource AncestorType=Window}}"/></Border.Background>
                        <Border.BorderBrush><SolidColorBrush Color="{Binding DataContext.BorderColor, RelativeSource={RelativeSource AncestorType=Window}}"/></Border.BorderBrush>
                        <ui:PlayerStatsControl/>
                    </Border>
                    <UniformGrid Columns="5">
                        <StackPanel><TextBlock Text="{DynamicResource ModernText_EBF2B9CF2880}" Style="{StaticResource ModernCaption}" Margin="0,0,0,4"/><ComboBox Style="{StaticResource MetricComboBox}" SelectedItem="{Binding Metric1, Mode=TwoWay}"/></StackPanel>
                        <StackPanel><TextBlock Text="{DynamicResource ModernText_BC23E19E7189}" Style="{StaticResource ModernCaption}" Margin="0,0,0,4"/><ComboBox Style="{StaticResource MetricComboBox}" SelectedItem="{Binding Metric2, Mode=TwoWay}"/></StackPanel>
                        <StackPanel><TextBlock Text="{DynamicResource ModernText_BDCCC708D9B8}" Style="{StaticResource ModernCaption}" Margin="0,0,0,4"/><ComboBox Style="{StaticResource MetricComboBox}" SelectedItem="{Binding Metric3, Mode=TwoWay}"/></StackPanel>
                        <StackPanel><TextBlock Text="{DynamicResource ModernText_EB93D06BC33F}" Style="{StaticResource ModernCaption}" Margin="0,0,0,4"/><ComboBox Style="{StaticResource MetricComboBox}" SelectedItem="{Binding Metric4, Mode=TwoWay}"/></StackPanel>
                        <StackPanel><TextBlock Text="{DynamicResource ModernText_0351452F253E}" Style="{StaticResource ModernCaption}" Margin="0,0,0,4"/><ComboBox Style="{StaticResource MetricComboBox}" SelectedItem="{Binding Metric5, Mode=TwoWay}"/></StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </DataTemplate>

    </Window.Resources>
    <Border CornerRadius="12" Background="{DynamicResource ModernSurface}" BorderBrush="{DynamicResource ModernLine}" BorderThickness="1">
    <Grid><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="14,0,5,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="{DynamicResource ModernText_20D54C595F51}" FontSize="10" Foreground="{DynamicResource ModernMuted}" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Button Content="−" Click="MinimizeWindow" Style="{StaticResource ModernChromeButton}" ToolTip="{DynamicResource ModernText_D72E311C4DDA}"/>
        <Button Content="□" Click="MaximizeWindow" Style="{StaticResource ModernChromeButton}" ToolTip="{DynamicResource ModernText_AB9616C1C81C}"/>
        <Button Content="×" Click="CloseWindow" Style="{StaticResource ModernChromeButton}" ToolTip="{DynamicResource ModernText_6E3EF7DE9A4F}"/>
      </StackPanel>
    </Grid><Grid Grid.Row="1">

 <Grid Background="{DynamicResource ModernSurface}" Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="8,4,4,22"><StackPanel><TextBlock Text="{DynamicResource ModernText_20D54C595F51}" Style="{StaticResource ModernCaption}" Foreground="{DynamicResource ModernAccent}"/><TextBlock Text="{DynamicResource ModernText_DDD1F0A0EAE4}" Style="{StaticResource ModernHeading}" Margin="0,6,0,0"/></StackPanel><Button Content="{DynamicResource ModernText_F42D8E075820}" Click="CloseWindow" Style="{StaticResource ModernButton}" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
  <Grid Grid.Row="1"><TabControl Style="{StaticResource ModernSidebar}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" SelectedIndex="{Binding SelectedIndex}"
                        TabStripPlacement="Left" ItemContainerStyle="{StaticResource ModernNavigation}" Padding="20,0,0,0"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        
                        Margin="0"
                        Visibility="Visible"
                        VerticalAlignment="Stretch">
                <!--Home-->
                <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><Path Data="{StaticResource Svg.Home}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/><TextBlock Text="{DynamicResource ModernText_C910D474DCD7}" VerticalAlignment="Center"/></StackPanel></TabItem.Header><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="6,6,16,12">
                    <StackPanel><TextBlock Text="{DynamicResource ModernText_15572DD76A17}" Foreground="{DynamicResource ModernMuted}" Margin="0,0,0,6"/><ComboBox x:Name="InterfaceLanguageSelector" ItemsSource="{Binding UiLanguages}" SelectedValuePath="Code" SelectedValue="{Binding InterfaceLanguage, Mode=TwoWay}" Style="{StaticResource ModernCombo}" Margin="0,0,0,6"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="{DynamicResource ModernText_1EBAE34C0C33}" TextWrapping="Wrap" Foreground="{DynamicResource ModernMuted}" Margin="0,0,0,14"/><settingsViews:SettingsHomeView
                        MaxWidth="500" /></StackPanel>
                </ScrollViewer></TabItem>
                <!--Detection-->
                <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><Path Data="{StaticResource Svg.Detection}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/><TextBlock Text="{DynamicResource ModernText_1900B478A586}" VerticalAlignment="Center"/></StackPanel></TabItem.Header><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="6,6,16,12">

                    <StackPanel MaxWidth="500">
                        <settings:SelectionSetting SelectedItem="{Binding CaptureMode, Mode=TwoWay}"
                                                   SettingName="{DynamicResource NativeText_CaptureMode}"
                                                   Choices="{x:Static local:SettingsWindowViewModel.CaptureModes}"
                                                   ChoicesType="{x:Type CaptureMode}" 
                                                   IsEnabled="{Binding CanChangeCaptureMode}"/>
                        <settings:CheckboxSetting IsOn="{Binding LowPriority, Mode=TwoWay}"
                                                  SettingName="{DynamicResource NativeText_SystemTray_LowPriority}" />
                        <settings:CheckboxSetting IsOn="{Binding CountOnlyBosses, Mode=TwoWay}"
                                                  SettingName="{DynamicResource NativeText_SystemTray_Count_only_bosses}" />
                        <settings:CheckboxSetting IsOn="{Binding DetectBossesByHpBar, Mode=TwoWay}"
                                                  SettingName="{DynamicResource NativeText_SystemTray_Detect_bosses_by_HP_bar}" />
                        <settings:CheckboxSetting IsOn="{Binding CountOnlyPartyMembers, Mode=TwoWay}"
                                                  SettingName="{DynamicResource NativeText_SystemTray_Count_only_party_members}" />
                        <settings:CheckboxSetting IsOn="{Binding IgnorePacketsThreshold, Mode=TwoWay}"
                                                  SettingName="{DynamicResource NativeText_SystemTray_IgnorePacketsThreshold}" />
                        <settings:ValueSetting Value="{Binding ResetTimeout, Mode=TwoWay}"
                                               SettingName="{DynamicResource NativeText_IdleResetTimeout}" Min="0" Max="600" />

                    </StackPanel>
                </ScrollViewer></TabItem>
                <!--UI-->
                <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><Path Data="{StaticResource Svg.UI}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/><TextBlock Text="{DynamicResource ModernText_3907FA7F8072}" VerticalAlignment="Center"/></StackPanel></TabItem.Header><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="6,6,16,12">
                    <StackPanel MaxWidth="500">
                        <settings:CheckboxSetting IsOn="{Binding AggroBasedTimer, Mode=TwoWay}"
                                                  SettingName="{DynamicResource NativeText_Display_timer_aggro_or_firsthit}" />
                        <settings:CheckboxSetting IsOn="{Binding DisplayOnlyBossHitByMeterUser, Mode=TwoWay}"
                                                  SettingName="{DynamicResource NativeText_Display_only_boss_hit_by_meter_user}" />
                        <settings:CheckboxSetting IsOn="{Binding ClickThru, Mode=TwoWay}"
                                                  SettingName="{DynamicResource NativeText_SystemTray_Click_throu}" />
                        <settings:CheckboxSetting IsOn="{Binding InvisibleWhenNoStats, Mode=TwoWay}"
                                                  SettingName="{DynamicResource NativeText_SystemTray_Invisible_when_no_stats}" />
                        <settings:CheckboxSetting IsOn="{Binding ShowAlways, Mode=TwoWay}"
                                                  SettingName="{DynamicResource NativeText_SystemTray_Show_always}" />
                        <settings:CheckboxSetting IsOn="{Binding StayTopmost, Mode=TwoWay}"
                                                  SettingName="{DynamicResource NativeText_SystemTray_Stay_topmost}" />
                        <settings:CheckboxSetting IsOn="{Binding SnapToBorders, Mode=TwoWay}"
                                                  SettingName="{DynamicResource NativeText_SystemTray_SnapToBorders}" />
                        <settings:CheckboxSetting IsOn="{Binding ShowSelfOnTop, Mode=TwoWay}"
                                                  SettingName="{DynamicResource NativeText_ShowSelfOnTop}" />
                        <settings:CheckboxSetting IsOn="{Binding FullscreenOverlay, Mode=TwoWay}"
                                                  SettingName="{DynamicResource NativeText_EnableOverlay}" IsEnabled="False" 
                                                  Visibility="Collapsed"/>
                        <settings:ValueSetting Value="{Binding NumberOfPlayersDisplayed, Mode=TwoWay}"
                                               SettingName="{DynamicResource NativeText_NumberPlayersDisplayed}" Min="1" Max="30" />
                        <settings:ValueSetting Value="{Binding MainWindowOpacity, Mode=TwoWay}"
                                               SettingName="{DynamicResource NativeText_SystemTray_MainWindowOpacity}"
                                               Min="0" Max="1" />
                        <settings:ValueSetting Value="{Binding OtherWindowsOpacity, Mode=TwoWay}"
                                               SettingName="{DynamicResource NativeText_SystemTray_OtherWindowOpacity}"
                                               Min="0.1" Max="1" />
                        <settings:ValueSetting x:Name="NotificationOpacitySetting" Value="{Binding NotificationOpacityPercent, Mode=TwoWay}" SettingName="{DynamicResource ModernText_5A0D55CCB291}" Min="10" Max="100" />
                        <settings:ValueSetting Value="{Binding Scale, Mode=TwoWay}" SettingName="{DynamicResource ModernText_F102986B39EF}" Min="0.5" Max="5" />
                        <!--<settings:ValueSetting Value="{Binding UpdatesPerSecond, Mode=TwoWay}"
                                               SettingName="{DynamicResource NativeText_UpdatesPerSecond}" Min="1" Max="20" />-->

                        <Grid Margin="35 10 0 10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Separator Grid.Column="0" Opacity=".2" />
                            <TextBlock Grid.Column="1" Text="{DynamicResource ModernText_88C45D9E526C}" Margin="10 0" Foreground="#3fff" />
                            <Separator Grid.Column="2" Opacity=".2" />
                        </Grid>
                        <UniformGrid Rows="1" Margin="28 0 0 0">
                            <local:ColorSetting SettingName="{DynamicResource ModernText_EA2B8A878841}"
                                                SelectedColor="{Binding BackgroundColor, Mode=TwoWay}"
                                                DefaultColor="{x:Static data:WindowData.DefaultBackgroundColor}" />
                            <local:ColorSetting SettingName="{DynamicResource ModernText_3B4BDFF339E9}" SelectedColor="{Binding BorderColor, Mode=TwoWay}"
                                                DefaultColor="{x:Static data:WindowData.DefaultBorderColor}" />
                            <local:ColorSetting SettingName="{DynamicResource ModernText_64AEE8C6CBD0}" SelectedColor="{Binding SelfColor, Mode=TwoWay}"
                                                DefaultColor="{x:Static data:WindowData.DefaultPlayerColor}" />
                        </UniformGrid>

                    </StackPanel>
                </ScrollViewer></TabItem>
                <!--Layout-->
                <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><Path Data="{StaticResource Svg.Layout}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/><TextBlock Text="{DynamicResource ModernText_A58DA793C725}" VerticalAlignment="Center"/></StackPanel></TabItem.Header><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="6,6,16,12">
                    <StackPanel Grid.IsSharedSizeScope="True">
                        <TextBlock Text="{DynamicResource ModernText_F978CD477527}" Style="{StaticResource ModernHeading}" Margin="0,0,0,6"/>
                        <TextBlock Text="{DynamicResource ModernText_5937BF91AA5A}" TextWrapping="Wrap" Foreground="{DynamicResource ModernMuted}" Margin="0,0,0,18"/>
                        <TextBlock Text="{DynamicResource ModernText_552833E2E06F}" Style="{StaticResource ModernCaption}" Margin="0,0,0,6"/>
                        <ContentControl Content="{Binding MockParty[0]}" ContentTemplate="{StaticResource MockPlayer}"/>
                        <TextBlock Text="{DynamicResource ModernText_CA604D552D44}" Style="{StaticResource ModernCaption}" Margin="0,0,0,6"/>
                        <ContentControl Content="{Binding MockParty[1]}" ContentTemplate="{StaticResource MockPlayer}"/>
                        <TextBlock Text="{DynamicResource ModernText_7AD6D8D0CE8E}" Style="{StaticResource ModernCaption}" Margin="0,0,0,6"/>
                        <ContentControl Content="{Binding MockParty[2]}" ContentTemplate="{StaticResource MockPlayer}"/>
                        <UniformGrid Rows="1" Margin="0,6,0,0">
                            <local:ColorSetting SettingName="{DynamicResource ModernText_CAECE7F58FCE}" SelectedColor="{Binding DpsColor, Mode=TwoWay}" DefaultColor="{x:Static data:WindowData.DefaultDpsColor}"/>
                            <local:ColorSetting SettingName="{DynamicResource ModernText_C0B21FB164DE}" SelectedColor="{Binding TankColor, Mode=TwoWay}" DefaultColor="{x:Static data:WindowData.DefaultTankColor}"/>
                            <local:ColorSetting SettingName="{DynamicResource ModernText_A491A33C72CD}" SelectedColor="{Binding HealerColor, Mode=TwoWay}" DefaultColor="{x:Static data:WindowData.DefaultHealerColor}"/>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer></TabItem>
                <!--TTS-->
                <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><Path Data="{StaticResource Svg.TTS}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/><TextBlock Text="{DynamicResource ModernText_3565FCC6C17D}" VerticalAlignment="Center"/></StackPanel></TabItem.Header><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="6,6,16,12">
                    <StackPanel MaxWidth="500">
                        <settings:CheckboxSetting IsOn="{Binding TtsMessagesTruncate, Mode=TwoWay}"
                                                  SettingName="{DynamicResource NativeText_TTSSizeExceededTruncate}" />
                        <settings:ValueSetting Value="{Binding TtsMaxSize, Mode=TwoWay}"
                                               SettingName="{DynamicResource NativeText_MaxTTSSize}"
                                               Min="10" Max="200"
                                               IsEnabled="{Binding TtsMessagesTruncate}" />
                    </StackPanel>
                </ScrollViewer></TabItem>
                <!--HP bar-->
                <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><Path Data="{StaticResource Svg.HPBar}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/><TextBlock Text="{DynamicResource ModernText_A2D238439AC5}" VerticalAlignment="Center"/></StackPanel></TabItem.Header><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="6,6,16,12">
                    <StackPanel MaxWidth="500">
                        <settings:CheckboxSetting IsOn="{Binding BossGageVisible, Mode=TwoWay}"
                                                  SettingName="{DynamicResource NativeText_ShowBossGage}" />
                        <settings:CheckboxSetting IsOn="{Binding BossGageAbnormalsDisabled, Mode=TwoWay}"
                                                  SettingName="{DynamicResource NativeText_NoAbnormalsInHUD}"
                                                  IsEnabled="{Binding BossGageVisible}" />
                    </StackPanel>
                </ScrollViewer></TabItem>
                <!--Graph-->
                <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><Path Data="{StaticResource Svg.Graph}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/><TextBlock Text="{DynamicResource ModernText_32AB018FD38A}" VerticalAlignment="Center"/></StackPanel></TabItem.Header><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="6,6,16,12">
                    <StackPanel MaxWidth="500">
                        <settings:CheckboxSetting IsOn="{Binding RealtimeGraphEnabled, Mode=TwoWay}"
                                                  SettingName="{DynamicResource NativeText_EnableRealtimeGraph}" />
                        <settings:SelectionSetting SelectedItem="{Binding GraphMode, Mode=TwoWay}"
                                                   SettingName="{DynamicResource NativeText_RealtimeGraphMode}"
                                                   Choices="{x:Static local:SettingsWindowViewModel.GraphModes}"
                                                   ChoicesType="{x:Type data:GraphMode}"
                                                   IsEnabled="{Binding RealtimeGraphEnabled}" />

                        <settings:ValueSetting Value="{Binding RealtimeGraphDisplayedInterval, Mode=TwoWay}"
                                               SettingName="{DynamicResource NativeText_RealtimeGraphDisplayedInterval}" Min="0"
                                               Max="600"
                                               IsEnabled="{Binding RealtimeGraphEnabled}" />
                        <settings:ValueSetting Value="{Binding RealtimeGraphCMAseconds, Mode=TwoWay}"
                                               SettingName="{DynamicResource NativeText_RealtimeGraphCmaSeconds}" Min="1"
                                               Max="60">
                            <settings:ValueSetting.Style>
                                <Style TargetType="settings:ValueSetting"
                                       BasedOn="{StaticResource {x:Type settings:ValueSetting}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GraphMode}" Value="DPS">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RealtimeGraphEnabled}" Value="False">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </settings:ValueSetting.Style>

                        </settings:ValueSetting>
                        <settings:CheckboxSetting IsOn="{Binding RealtimeGraphAnimated, Mode=TwoWay}"
                                                  SettingName="{DynamicResource NativeText_RealtimeGraphAnimated}"
                                                  IsEnabled="{Binding RealtimeGraphEnabled}" />

                    </StackPanel>
                </ScrollViewer></TabItem>
                <!--Servers-->
                <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><Path Data="{StaticResource Svg.Servers}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/><TextBlock Text="{DynamicResource ModernText_D084236CBCC7}" VerticalAlignment="Center"/></StackPanel></TabItem.Header>
                    <TabItem.Resources>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0 0 0 2" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                        <Grid Background="Transparent" Margin="{TemplateBinding Padding}">

                                            <Rectangle x:Name="hl" Fill="#1fff" Opacity="0" IsHitTestVisible="False" />
                                            <Rectangle x:Name="alt" Fill="#1779" Opacity="0" IsHitTestVisible="False" />
                                            <ContentPresenter Margin="0" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <!--<Setter Property="Opacity" TargetName="hl" Value="1" />-->
                                            </Trigger>
                                            <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                                <Setter Property="Opacity" TargetName="alt" Value="0" />
                                            </Trigger>
                                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                                <Setter Property="Opacity" TargetName="alt" Value="1" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabItem.Resources><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="6,6,16,12">
                    <Grid MaxWidth="500">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ListBox ScrollViewer.CanContentScroll="False" ItemsSource="{Binding DpsServers}"
                                 Background="Transparent" BorderThickness="0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="teraDpsApi:DpsServer">
                                    <ui:DpsServer />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ListBox>
                        <Separator Grid.Row="1" VerticalAlignment="Top" Margin="-20 2" Opacity=".2" />
                        <Button Grid.Row="1" Command="{Binding AddServerCommand}" VerticalAlignment="Center"
                                VerticalContentAlignment="Center"
                                HorizontalContentAlignment="Center"
                                Margin="0 8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Path Fill="White" Stretch="Uniform" Width="16" Height="16"
                                      Margin="8 0"
                                      Data="{StaticResource Svg.AddServer}" />
                                <TextBlock Grid.Column="1" Text="{DynamicResource NativeText_SystemTray_AddServer}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </Grid>
                </ScrollViewer></TabItem>
                <!--Events-->
                <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><Path Data="{StaticResource Svg.Events}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/><TextBlock Text="{DynamicResource ModernText_8D14F6E72DE8}" VerticalAlignment="Center"/></StackPanel></TabItem.Header><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="6,6,16,12">
                    <StackPanel MaxWidth="500">
                        <settings:CheckboxSetting IsOn="{Binding EnableChatAndNotif, Mode=TwoWay}"
                                                  SettingName="{DynamicResource NativeText_EnableChat}" />
                        <settings:CheckboxSetting IsOn="{Binding AutoDisableChatWhenOverloaded, Mode=TwoWay}"
                                                  SettingName="{DynamicResource NativeText_AutoDisableChatWhenOverloaded}"
                                                  IsEnabled="{Binding EnableChatAndNotif}" />
                        <settings:CheckboxSetting IsOn="{Binding MuteSound, Mode=TwoWay}"
                                                  SettingName="{DynamicResource NativeText_MuteSound}"
                                                  IsEnabled="{Binding EnableChatAndNotif}" />
                        <settings:CheckboxSetting IsOn="{Binding CopyInspectOnApply, Mode=TwoWay}"
                                                  IsEnabled="{Binding EnableChatAndNotif}"
                                                  SettingName="{DynamicResource NativeText_CopyInspect}" />
                        <settings:CheckboxSetting IsOn="{Binding DisablePartyEvents, Mode=TwoWay}"
                                                  IsEnabled="{Binding EnableChatAndNotif}"
                                                  SettingName="{DynamicResource NativeText_DisablePartyEvents}" />
                        <TextBlock Text="{DynamicResource ModernText_F67B87241682}" TextWrapping="Wrap" Style="{StaticResource ModernCaption}" Margin="0,12,0,0"/>
                        <!--<Button Content="{DynamicResource ModernText_B3E227CECFE3}" VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                VerticalContentAlignment="Center"
                                HorizontalContentAlignment="Center"
                                Padding="10 0" Command="{Binding OpenEventEditorCommand}"/>-->
                    </StackPanel>
                </ScrollViewer></TabItem>
                <!--Rich presence-->
                <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><Path Data="{StaticResource Svg.Discord}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/><TextBlock Text="{DynamicResource ModernText_053BC65874AD}" VerticalAlignment="Center"/></StackPanel></TabItem.Header><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="6,6,16,12">
