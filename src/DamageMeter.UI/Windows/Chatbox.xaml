<ui:ClickThrouWindow x:Class="DamageMeter.UI.Chatbox"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:ui="clr-namespace:DamageMeter.UI"
                     mc:Ignorable="d"
                     Height="800"
                     MinHeight="10" MinWidth="10"
                     ResizeMode="CanResizeWithGrip"
                     Title="Modern Meter — Chat"
 xmlns:mm="clr-namespace:DamageMeter.UI" Icon="{x:Static mm:ModernDamageMark.ApplicationImage}">
    <Window.Resources>
        <Style x:Key="ModernAuxButton" TargetType="Button" BasedOn="{StaticResource ModernButton}"><Setter Property="Padding" Value="4"/><Setter Property="Margin" Value="0"/></Style>
    </Window.Resources>
    <Window.Background>
        <SolidColorBrush Color="Transparent" Opacity="0" />
    </Window.Background>
    <Grid MouseLeftButtonDown="Move" Margin="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ui:ClickThrouWindow}, Path=AllowsTransparency, Converter={StaticResource BoolToMargin}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.LayoutTransform>
            <ScaleTransform CenterX="0" CenterY="0"
                            ScaleX="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ui:ClickThrouWindow}, Path=Scale}"
                            ScaleY="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ui:ClickThrouWindow}, Path=Scale}" />
        </Grid.LayoutTransform>
        <Border Style="{StaticResource MainBorder}" Grid.RowSpan="2" CornerRadius="10" Background="{DynamicResource ModernSurface}" BorderBrush="{DynamicResource ModernLine}" BorderThickness="1"/>
        <Image x:Name="ChromeBrandIcon" Grid.Row="0" Margin="14,0,0,0" Style="{StaticResource ModernCaptionIcon}"/>
        <TextBlock Grid.Row="0" Margin="44,0,44,0" Text="{DynamicResource ModernText_460B3A7DA007}" FontFamily="Segoe UI" FontSize="12" Foreground="{DynamicResource ModernText}" VerticalAlignment="Center" IsHitTestVisible="False"/>
        <Grid Grid.Row="0">
            <Button x:Name="CloseStats" HorizontalAlignment="Right" Width="34" Style="{StaticResource ModernAuxButton}" Background="Transparent"
                    Opacity="0.85"
                    Foreground="White" Click="Close_OnClick" HorizontalContentAlignment="Stretch"
                    VerticalAlignment="Top" Margin="0">
                <Image x:Name="CloseWindow"
                       Stretch="Fill"
                       HorizontalAlignment="Left"
                       Height="29" VerticalAlignment="Top" Width="29" />
            </Button>
        </Grid>

        <ScrollViewer Name="ScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">

            <ListBox Name="ChatboxList" Background="Transparent" BorderThickness="0"
                     PreviewMouseWheel="ChatboxList_PreviewMouseWheel"
                     Focusable="False" SelectionMode="Extended" SelectionChanged="ChatboxList_OnSelectionChanged"
                     HorizontalContentAlignment="Stretch" IsTextSearchEnabled="False"
                     HorizontalAlignment="Left" />
        </ScrollViewer>


    </Grid>
</ui:ClickThrouWindow>